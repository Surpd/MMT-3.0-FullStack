# Copy these values into the shell/secret store used for local authenticated E2E.
# The Supabase project must be isolated from production. Never commit the key.
TEST_MODE=true
VITE_TEST_MODE=true
TEST_USER_ID=900000001
VITE_TEST_USER_ID=900000001
RUNTIME_ENV=development
ALLOW_PRODUCTION_TEST_USER=false
TEST_SUPABASE_URL=https://<isolated-test-project>.supabase.co
TEST_SUPABASE_KEY=<isolated-test-key>
