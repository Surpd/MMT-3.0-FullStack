# Copy these values into the shell/secret store used for local authenticated E2E.
# E2E uses the current MMT Supabase only with explicit opt-in. Never commit the key.
TEST_MODE=true
VITE_TEST_MODE=true
TEST_USER_ID=900000001
VITE_TEST_USER_ID=900000001
RUNTIME_ENV=development
ALLOW_PRODUCTION_TEST_USER=false
# Backend-only current MMT target; never expose this key to Vite/browser.
# SUPABASE_URL=https://<current-mmt-project>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<privileged-server-key>
